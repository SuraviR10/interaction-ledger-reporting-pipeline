# Environment Configuration Example
# Copy this file to .env and replace the placeholder values with actual generated keys.
# NEVER commit the actual .env file to Git!

# 1. PII Encryption Key (Fernet 32-byte url-safe base64 string)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=replace_with_a_valid_fernet_key

# 2. Phone Hash Secret Key (HMAC secret key)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PHONE_HASH_KEY=replace_with_a_secure_hmac_secret_key

# Optional: Custom database path (defaults to ./ledger.db if unset)
# LEDGER_DB_PATH=./ledger.db

